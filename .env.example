# Backend origin (same as API_PUBLIC_URL on the server), e.g. https://api.yourdomain.com
# - no trailing slash, no /api suffix
# - read at BUILD time (npm run build) — put it in .env.production, then rebuild when it changes
# - leave EMPTY in development (Vite proxies /api → http://localhost:4000) or when the frontend and
#   backend are served from the same domain with /api and /embed.js forwarded to Node
VITE_API_URL=
